# ==========================================
# EDRP Docker Environment Configuration Template
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_DB=edrp
POSTGRES_USER=edrp_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# Backend Database URL (Used by FastAPI container to connect to PostgreSQL)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# JWT & Authentication Security
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email Delivery Configuration (Gmail / SMTP)
SMTP_EMAIL=your_smtp_email@gmail.com
SMTP_APP_PASSWORD=your_app_password_here

# AI Support / Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Application Ports & Service Hostnames
BACKEND_PORT=8000
FRONTEND_PORT=5000
BACKEND_URL=http://backend:8000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
